{
  "name": "dsh-marshal-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "调度官手机端（Android / iOS）：dsh-marshal 的只读客户端外壳，不承载 hub/node",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "cap:sync": "npm run build && cap sync",
    "android:add": "cap add android",
    "ios:add": "cap add ios",
    "android:build": "npm run cap:sync && bash scripts/build-android.sh",
    "ios:build": "npm run cap:sync && bash scripts/build-ios.sh"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "marshal-push": "file:./plugins/marshal-push",
    "marshal-stream": "file:./plugins/marshal-stream"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
