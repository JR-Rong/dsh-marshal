{
  "name": "dsh-marshal",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./lib/src/index.js",
    "./client": "./client/index.js"
  },
  "bin": {
    "marshal-device": "./lib/src/bin/device.js",
    "marshal-hub": "./lib/src/bin/hub.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "client"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:plugin-client": "node scripts/build-plugin-client.mjs",
    "test": "vitest run && node --test plugin-build/test/*.test.js",
    "test:memory": "node --test plugin-build/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "entities": "9.0.0",
    "marked": "18.1.2",
    "uqr": "0.1.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
